# Copy this file to .env.local and fill in real values once a Sanity
# project exists (sanity.io/manage or `npx sanity init`).
# .env.local is gitignored by default — never commit real values.

NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2026-01-01

# Write-access token, used only server-side (content migration script,
# and later for any server action that writes to Sanity). Create at
# sanity.io/manage -> your project -> API -> Tokens -> Add API token
# (Editor permission is enough). NEVER expose this with a NEXT_PUBLIC_ prefix.
SANITY_API_WRITE_TOKEN=
